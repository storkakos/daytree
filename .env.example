# Optional. Credentials do NOT belong here - configure everything in the dashboard.
PORT=8080

# Optional. Time zone name for the dashboard times.
TZ=Europe/Berlin

# Optional: provide the encryption key yourself instead of using the key file in the "timetree-secrets" volume.
# Generate one with:
#   docker run --rm python:3.12-alpine sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())'"
# Then add "SECRET_KEY: ${SECRET_KEY}" under environment: in docker-compose.yml.
#SECRET_KEY=
