# Optional. Credentials do NOT belong here - configure everything in the dashboard.
PORT=8080

# Optional. Version of the prebuilt image, such as 0.23.0 or 0.23. Default: the newest release.
#DAYTREE_VERSION=latest

# Optional. Time zone name for the dashboard times.
TZ=Europe/Berlin

# Optional. true = the settings need a password. The password itself is set in the browser, never here.
SETTINGS_LOCK=false

# Optional. Address of a reverse proxy that serves Daytree over HTTPS, such as https://daytree.example.com.
# Browsers are sent there for the homepage and the settings, and writes over plain HTTP are refused.
HTTPS_URL=

# Optional: provide the encryption key yourself instead of using the key file in the "daytree-secrets" volume.
# Generate one with:
#   docker run --rm python:3.12-alpine sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())'"
# Then add "SECRET_KEY: ${SECRET_KEY}" under environment: in docker-compose.yml.
#SECRET_KEY=
